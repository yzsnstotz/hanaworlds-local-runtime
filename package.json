{
  "name": "hanaworlds-local-runtime",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "Cordis Luanti world-source lifecycle and native engine provider",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    },
    "./examples/world-lifecycle.json": "./examples/world-lifecycle.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/build-source.json",
    "engine-control/main.go",
    "engine-control/idle-stream.go",
    "engine-control/packet-stream.go",
    "engine-control/go.mod",
    "engine-control/go.sum",
    "scripts/build-engine-control-runtime.mjs",
    "scripts/prepare-hanaworlds-game-client.mjs",
    "scripts/hanaworlds-game-client.json",
    "scripts/prepare-hanaworlds-luanti-content.mjs",
    "scripts/hanaworlds-luanti-content.json",
    "LICENSE",
    "NOTICE",
    "examples",
    "licenses"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && npm run test:package-boundary",
    "verify:contracts": "npm run build && node scripts/verify-contracts.mjs",
    "test": "vitest run && npm run test:package-boundary",
    "build:helper": "cd engine-control && go build -trimpath -o ../dist/native-control .",
    "test:probe": "node scripts/test-probe.mjs",
    "prepack": "node scripts/prepack.mjs",
    "test:package-boundary": "node scripts/test-package-boundary.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.8.3",
    "vitest": "4.1.11",
    "hanaworlds-contracts": "git+https://github.com/yzsnstotz/hanaworlds-contracts.git#v2.5.0"
  }
}
