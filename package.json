{
  "name": "hanaworlds-local-runtime",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Cordis local Luanti runtime provider; engine lifecycle only in local-runtime-01",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    }
  },
  "files": [
    "dist",
    "engine-control",
    "scripts",
    "docs",
    "LICENSE",
    "NOTICE",
    "examples",
    "licenses"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "verify:contracts": "npm run build && node scripts/verify-contracts.mjs",
    "test": "vitest run",
    "build:helper": "cd engine-control && go build -trimpath -o ../dist/native-control .",
    "test:probe": "node scripts/test-probe.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "hanaworlds-contracts": "git+https://github.com/yzsnstotz/hanaworlds-contracts.git#v2.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  }
}
